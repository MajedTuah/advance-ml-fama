# .dockerignore — exclude files from Docker build context
# This keeps the image lean and the build fast

# Git history
.git
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
.venv/
venv/
env/
.env

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# MLflow runs (mounted as volume, not baked in)
mlruns/

# Test artifacts
*.log
*.tmp

# IDE configs
.vscode/
.idea/
*.swp
